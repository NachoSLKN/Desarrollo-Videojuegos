function room_LeaveTop()
{
  cInspector.Say("No es en esta direccion"); //Desbloquear personaje tras decirlo
  
// Mueve el personaje fuera de la pantalla
// Mueve a cPanteraRosa fuera de la pantalla
cPanteraRosa.x = -1000;
cPanteraRosa.y = -1000;

cInspector.ChangeRoom(1,  500,  182);
 Transicion.Play();

cInspector.FaceDirection(eDirectionDown);

}

