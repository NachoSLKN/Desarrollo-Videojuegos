function room_LeaveRight()
{
cInspector.ChangeRoom(6,  522,  368);
 Transicion.Play();

}

function oGranada_Interact(Object *theObject, CursorMode mode)
{
  
cInspector.Walk(106,  475, eBlock); 

cInspector.Say("Con esta granada podremos abrirnos paso");

oGranada.Visible=false;

cInspector.AddInventory(iGranada);

}



function oEsposas_Interact(Object *theObject, CursorMode mode)
{
  
cInspector.Walk(105,  473, eBlock); 
    
cInspector.Say("Con estas esposas nadie se podrá resistir");

oEsposas.Visible=false;

cInspector.AddInventory(iEsposas);

}


function oCalendario_Look(Object *theObject, CursorMode mode)
{
cInspector.Walk(650,  278, eBlock); 
cInspector.Say("Un calendario, me pregunto que día será hoy...");
}

function oCalendario_Interact(Object *theObject, CursorMode mode)
{
cInspector.Walk(651, 284, eBlock);
cInspector.ChangeRoom(7);
gGui2.Visible = true;
gGui1.Visible = false;
gMenuPrincipal.Visible = false;
}


