// room script file

int peldanosFaltantes = 3; // Contador para rastrear los peldanos faltantes

function room_LeaveLeft()
{
    cInspector.ChangeRoom(5, 842, 244);
    Transicion.Play();
    cInspector.FaceDirection(2);
}

function room_LeaveTop()
{
    cInspector.ChangeRoom(3, 735, 181);
    Transicion.Play();
    gCaja.Visible = false;
}

function agregarPeldano()
{
    if (cInspector.ActiveInventory == iPeldano1) {
        cInspector.LoseInventory(iPeldano1);
    } else if (cInspector.ActiveInventory == iPeldano2) {
        cInspector.LoseInventory(iPeldano2);
    } else if (cInspector.ActiveInventory == iPeldano3) {
        cInspector.LoseInventory(iPeldano3);
    } else {
        cInspector.Say("No tengo ningún peldano para añadir.");
        return;
    }

    // Volver el cursor al modo interactuar
    mouse.Mode = eModeInteract;
    
    peldanosFaltantes--;

    if (peldanosFaltantes == 2) {
        oEscalera3.Visible = false;
        oEscalera2.Visible = true;
    } else if (peldanosFaltantes == 1) {
        oEscalera2.Visible = false;
        oEscalera1.Visible = true;
    } else if (peldanosFaltantes == 0) {
        oEscalera1.Visible = false;
        oEscaleraComp.Visible = true;
    }
}

function oPeldano2_Interact(Object *theObject, CursorMode mode)
{
    cInspector.Walk(467, 300, eBlock); 
    cInspector.Say("Peldano 2");
    oPeldano2.Visible = false;
    cInspector.AddInventory(iPeldano2);
}

function oPeldano1_Interact(Object *theObject, CursorMode mode)
{
    cInspector.Walk(227, 280, eBlock); 
    cInspector.Say("Peldano 1");
    oPeldano1.Visible = false;
    cInspector.AddInventory(iPeldano1);
}

function region1_WalksOnto(Region *theRegion)
{
    cInspector.ChangeRoom(5, 626, 251, eDirectionLeft);
    gCoche.Visible = true;
    gCaja.Visible = false;
}

function room_FirstLoad()
{
    oCajaBien.Visible = true;
    oCajaMal.Visible = false;
    oCajaRota.Visible = false;
    oPeldano3.Visible = false;

    oEscalera3.Visible = true;
    oEscalera2.Visible = false;
    oEscalera1.Visible = false;
    oEscaleraComp.Visible = false;
    peldanosFaltantes = 3;
}

function oCajaBien_Interact(Object *theObject, CursorMode mode)
{
    cInspector.Walk(577, 387, eBlock); 
    oCajaBien.Visible = false;
    oCajaMal.Visible = true;
    oCajaRota.Visible = false;
    oPeldano3.Visible = false;
}

function oCajaMal_Interact(Object *theObject, CursorMode mode)
{
    cInspector.Walk(577, 387, eBlock); 
    oCajaBien.Visible = false;
    oCajaMal.Visible = false;
    oCajaRota.Visible = true;
    oPeldano3.Visible = true;
}

function oPeldano3_Interact(Object *theObject, CursorMode mode)
{
    cInspector.Walk(577, 387, eBlock); 
    cInspector.Say("Peldano 3");
    oPeldano3.Visible = false;
    cInspector.AddInventory(iPeldano3);
}

function oEscalera3_Interact(Object *theObject, CursorMode mode)
{
    if (cInspector.ActiveInventory == iPeldano1 || 
        cInspector.ActiveInventory == iPeldano2 || 
        cInspector.ActiveInventory == iPeldano3) {
        agregarPeldano();
    } else {
        cInspector.Say("No puedo usar la escalera, le faltan 3 peldanos.");
        Display("Para poner los peldaños debes elegir el peldaño en el inventario y clicar la escalera con el cursor de interactuar");
    }
}

function oEscalera2_Interact(Object *theObject, CursorMode mode)
{
    if (cInspector.ActiveInventory == iPeldano1 || 
        cInspector.ActiveInventory == iPeldano2 || 
        cInspector.ActiveInventory == iPeldano3) {
        agregarPeldano();
    } else {
        cInspector.Say("No puedo usar la escalera, le faltan 2 peldanos.");
        Display("Para poner los peldaños debes elegir el peldaño en el inventario y clicar la escalera con el cursor de interactuar");
    }
}

function oEscalera1_Interact(Object *theObject, CursorMode mode)
{
    if (cInspector.ActiveInventory == iPeldano1 || 
        cInspector.ActiveInventory == iPeldano2 || 
        cInspector.ActiveInventory == iPeldano3) {
        agregarPeldano();
    } else {
        cInspector.Say("No puedo usar la escalera, le falta 1 peldano.");
        Display("Para poner los peldaños debes elegir el peldaño en el inventario y clicar la escalera con el cursor de interactuar");
    }
}

function oEscaleraComp_Interact(Object *theObject, CursorMode mode)
{
    cInspector.ChangeRoom(3, 735, 181);
}