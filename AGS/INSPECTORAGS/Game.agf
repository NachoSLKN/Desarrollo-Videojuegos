    <Dialogs>
      <DialogFolder Name="Main">
        <SubFolders />
        <Dialogs>
          <Dialog>
            <ID>0</ID>
            <Name>dDialog1</Name>
            <ShowTextParser>False</ShowTextParser>
            <Script><![CDATA[// Dialog script file
@S  // Dialog startup entry point
 bool idea = false;
return
@1
cInspector: ¿Informe de misión?
cAyudante: Nos encontramos en las orillas de la ciudad. 
cAyudante: Nos han llamado porque hay un criminal en estos suburbios, si cruzas la calle darás con él.
cAyudante: Toma, ten esta pata de conejo como amuleto de suerte. 
cAyudante:¡Bah! No la necesito... No entiendo como alguien tan supersticioso ha podido entrar al cuerpo de policía.
option-on 3
return
@2
cInspector: ¿Informe del criminal? 
cAyudante: Ten cuidado, no sabemos a que nos enfrentamos.
cAyudante: Dicen que es muy peligroso pero no sabemos quién es, solo sabemos su nombre: Hassan.
return
@3 
cInspector: ¿Sigues teniendo la pata de conejo?
cAyudante: Si, por qué inspector, no decía que era supersticioso?
cInspector: Sí, lo sigo pensando, pero por probar no pasa nada.
cAyudante: Tome entonces
 cInspector.AddInventory(iPataconejo);
option-off3
return
@4
cInspector: No se como pasar al otro lado, ¿Alguna idea?
cAyudante: Está muy atento de sus movimientos, debería tratar de asustarlo para que se vaya durante un momento.
option-on 5
option-off 4
return
@5
cInspector: Deme algo que lo distraiga chico.
cAyudante: Tome inspector.
cInspector: ¿¡Una granada!? Me gusta como piensas.
 cInspector.AddInventory(iGranada);
return
@6
cAyudante: Hasta luego inspector!
 if (!player.HasInventory(iEsposas)) {
cAyudante: Recuerde revisar el maletero del coche, no vaya a ser que nos hayamos olvidado algo.
 gCoche.Visible = true;
 }
 if (player.HasInventory(iEsposas)) {
    cAyudante.Say("A por él inspector ya tiene todo lo que necesita");
    cAyudante.Say("...");
    cAyudante.Say("¿Verdad?");
 } 
stop
//goto-dialogue para ir de un dialogo a otro]]></Script>
            <DialogOptions>
              <DialogOption>
                <ID>1</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">¿Informe de misión?</Text>
              </DialogOption>
              <DialogOption>
                <ID>2</ID>
                <Say>False</Say>
                <Show>True</Show>
                <Text xml:space="preserve">¿Informe del criminal?</Text>
              </DialogOption>
              <DialogOption>
                <ID>3</ID>
