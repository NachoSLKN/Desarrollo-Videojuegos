// room script file




function room_LeaveLeft()
{
cInspector.ChangeRoom(3, 35, 353);
Transicion.Play();
cInspector.FaceDirection(2);

}

function room_FirstLoad()
{
cHassan.Say("¡En cuanto te vea, te dejaré como un queso Gruyère! Como que me llamo Hassan.");
cHassan.Say("Ríndete Inspector, ni tu ni tus amigos vais a poder detenerme.");

}

function region1_WalksOnto(Region *theRegion)
{
cInspector.ChangeRoom(3,  102, 430,   eDirectionRight);
Transicion.Play();
}

function region2_WalksOnto(Region *theRegion)
{
cInspector.ChangeRoom(3, 181, 145, eDirectionRight);
Transicion.Play();
}

function region3_WalksOnto(Region *theRegion)
{
cInspector.ChangeRoom(2, 701, 355, eDirectionDown );
Transicion.Play();
gCaja.Visible = true;
}
