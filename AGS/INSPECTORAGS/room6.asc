// room script file


function room_Load()
{
 gGui2.Visible = true;
}




function oHassan_UseInv(Object *theObject, CursorMode mode)
{
  if(player.ActiveInventory==iGranada){
 player.LoseInventory(iGranada);
 cInspector.Say("¡Pillala Hassan!");
 cInspector.Say("Noo, ¡Malditas manos sudorosas!");
 Granada.Play();
 oHassan.Visible =false;
//oGranada.Move(512,  403,  4,  eBlock,  eAnywhere);
//Keydown=1;
cInspector.ChangeRoom(5,  725,  350);
Transicion.Play();
cInspector.FaceDirection(2);
Display("Puedes escuchar a Hassan riendose de fondo");
cInspector.Say("¡Me chachis!");
gGui2.Visible = false;
}
}


